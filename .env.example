# =========================================================
# EDUPAY MANAGER — ENVIRONMENT VARIABLES (.env.example)
# =========================================================

# 1. CLIENT-SAFE PUBLIC VARIABLES (Safe for frontend bundle)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-placeholder"
APP_URL="http://localhost:3000"

# 2. SERVER-ONLY SECRET VARIABLES (NEVER expose with VITE_ or NEXT_PUBLIC_ prefix!)
# Used only by server.ts / Supabase Edge Functions / Admin CLI provisioning
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key-placeholder"
ADMIN_INITIAL_EMAIL="admin@edupay.uz"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
SESSION_SECRET="CHANGE_ME_RANDOM_64_BYTE_HEX_SECRET"
