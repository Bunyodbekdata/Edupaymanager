{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/rest/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|rest/v1/).*)",
      "destination": "/index.html"
    }
  ]
}
